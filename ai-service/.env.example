# ==============================================================================
# BHASHABRIDGE AI MICROSERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================

AI_SERVICE_PORT=5001

# ------------------------------------------------------------------------------
# SOVEREIGN AI ENGINE (ai-engine/app.py, exposed on :8000)
# Local loopback is tried first; the public domain is only a fallback.
# ------------------------------------------------------------------------------
LOCAL_AI_ENGINE_ENDPOINT=http://localhost:8000
AI_ENGINE_DOMAIN=
INDICTRANS2_ENDPOINT=http://localhost:8000
WHISPER_ENDPOINT=http://localhost:8000
LOCAL_TTS_ENDPOINT=http://localhost:8000/tts

# ------------------------------------------------------------------------------
# BHASHINI (National Language Translation Mission - MeitY, Govt of India)
# Get your free credentials at: https://bhashini.gov.in/ulca/user/register
# Leave blank to use the self-hosted engine only.
# ------------------------------------------------------------------------------
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_KEY=
BHASHINI_ENDPOINT=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ------------------------------------------------------------------------------
# MEETING SUMMARIZATION & INTELLIGENCE
# Without a key the service falls back to a deterministic structural summary.
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=

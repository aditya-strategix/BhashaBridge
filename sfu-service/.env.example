# ==============================================================================
# BHASHABRIDGE MEDIASOUP SFU ENVIRONMENT CONFIGURATION
# ==============================================================================

SFU_PORT=5002
SFU_HOST=0.0.0.0
SFU_NUM_WORKERS=2

# WebRTC media ports
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# Mediasoup listen address, and the address advertised to browsers.
# Leave ANNOUNCED_IP blank to auto-detect a non-loopback LAN IPv4.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=

SFU_ICE_SERVERS=stun:stun.l.google.com:19302
CORS_ORIGIN=*

# Server-side audio tap -> AI service STT
AI_SERVICE_URL=http://localhost:5001
SFU_AUDIO_TAP_ENABLED=false
SFU_AUDIO_TAP_CHUNK_MS=500
SFU_AUDIO_TAP_TIMEOUT_MS=20000

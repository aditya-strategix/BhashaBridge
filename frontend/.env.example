# BhashaBridge frontend service URLs
# NEXT_PUBLIC_API_URL may include or omit the trailing /api; it is normalised.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# SFU signaling/media service. Leave unset in local dev to use
# http://<page-host>:5002 (or a same-origin reverse proxy on HTTPS).
NEXT_PUBLIC_SFU_URL=http://localhost:5002

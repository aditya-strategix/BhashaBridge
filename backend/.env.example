# ==============================================================================
# BHASHABRIDGE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://bhashabridge:password@localhost:5432/bhashabridge
DIRECT_URL=postgresql://bhashabridge:password@localhost:5432/bhashabridge

PORT=5000

# Use a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-32-byte-random-secret

# Email delivery (password reset OTPs / invitations)
RESEND_API_KEY=

# AI services
DEEPSEEK_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:5001
SFU_SERVICE_URL=http://127.0.0.1:5002
VALKEY_URL=redis://localhost:6379

# Public frontend origin used to build invitation links
FRONTEND_URL=http://localhost:3000
